# Fixed-purpose endpoints under grasp/: no command dispatch in the client.
# observation_id binds the mask/cloud/candidates to one stationary RGB-D capture.
# Optional segmentation text, used only by segment_object. Empty uses configured target.
string target_text
string observation_id
sensor_msgs/Image object_mask
sensor_msgs/PointCloud2 object_cloud
# Selection receives an explicit BT-owned exposure; no perception session server.
sensor_msgs/Image rgb_image
sensor_msgs/Image depth_image
sensor_msgs/CameraInfo camera_info
sensor_msgs/JointState capture_joints
rwh_beyond_msgs/GraspCandidate[] candidates
string plan_id
# Opt-in point-cloud aperture estimation for the selected model pose.
bool use_estimated_width
# Zero uses the motion YAML fallback; BT may explicitly choose distances (m).
float64 pregrasp_distance
float64 lift_distance
# Explicitly release the previous target at the current pose before a new pick.
bool release_previous
---
bool success
string message
string observation_id
sensor_msgs/Image object_mask
sensor_msgs/PointCloud2 object_cloud
rwh_beyond_msgs/GraspCandidate[] candidates
string plan_id
rwh_beyond_msgs/TcpPose pregrasp
rwh_beyond_msgs/TcpPose grasp_pose
float64 grasp_width
float64 close_width
string width_source
---
string stage
