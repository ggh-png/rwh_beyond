# mode=1 runs the pick tree; mode=2 runs the guarded place/release tree.
# mode=0 remains a legacy alias for mode=1 when behavior_tree is empty.
uint8 MODE_PICK=1
uint8 MODE_PLACE=2
uint8 mode
# Optional custom tree path. When present, it overrides mode selection.
string behavior_tree
# Optional SAM target description for this goal only; empty uses configured target_text.
string target_text
---
# Native signed MoveIt/controller error code; 0 means demo success.
# BT-local errors use -1000 and below. See error_source/error_name.
int32 error_code
string error_name
string error_source
string error_msg
string failed_stage
string failed_node
string moveit_state
---
string current_stage
string current_node
string moveit_state
int32 error_code
string error_name
string error_source
string error_msg
