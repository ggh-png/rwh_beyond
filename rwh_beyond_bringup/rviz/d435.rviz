Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: d435_link
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: D435 Color Point Cloud
      Enabled: true
      Topic:
        Value: /camera/d435/depth/color/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Queue Size: 5
      Style: Points
      Size (Pixels): 2
      Size (m): 0.003
      Alpha: 1
      Color Transformer: RGB8
      Position Transformer: XYZ
    - Class: rviz_default_plugins/Image
      Name: D435 RGB
      Enabled: true
      Topic:
        Value: /camera/d435/color/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Transport Hint: raw
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: D435 Aligned Depth
      Enabled: true
      Topic:
        Value: /camera/d435/aligned_depth_to_color/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Transport Hint: raw
      Normalize Range: true
    - Class: rviz_default_plugins/TF
      Name: Camera TF
      Enabled: true
      Frame Timeout: 15
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.1
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2
      Focal Point:
        X: 0.8
        Y: 0
        Z: 0
      Pitch: 0.3
      Yaw: 3.14
Window Geometry:
  Width: 1400
  Height: 900
