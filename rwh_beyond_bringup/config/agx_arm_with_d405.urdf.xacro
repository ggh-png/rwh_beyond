<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agx_arm">
  <xacro:include filename="$(find agx_arm_moveit)/config/agx_arm.urdf.xacro"/>
  <xacro:arg name="camera_nominal_tf" default="true"/>
  <xacro:property name="mount" value="${xacro.load_yaml('$(find moma_mujoco_ros)/project/config/cameras/d405.yaml')}"/>
  <xacro:arg name="d405_mount_parent" default="${mount['parent_frame']}"/>
  <xacro:arg name="d405_mount_xyz" default="${mount['translation_m'][0]} ${mount['translation_m'][1]} ${mount['translation_m'][2]}"/>
  <xacro:arg name="d405_mount_rpy" default="${mount['body_rpy_rad'][0]} ${mount['body_rpy_rad'][1]} ${mount['body_rpy_rad'][2]}"/>
  <!-- The body origin is the SDK zero-depth point. Mesh transform follows RealSense _d405.urdf.xacro. -->
  <link name="d405_link">
    <visual>
      <origin xyz="0.0038 -0.009 0" rpy="${pi/2} 0 ${pi/2}"/>
      <geometry><mesh filename="package://moma_description/meshes/d405.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="d405_aluminum"><color rgba="0.7 0.7 0.72 1"/></material>
    </visual>
    <collision>
      <origin xyz="-0.0078 -0.009 0"/>
      <geometry><box size="0.023 0.042 0.042"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0078 -0.009 0"/>
      <mass value="0.06"/>
      <inertia ixx="0.00001764" iyy="0.000011465" izz="0.000011465" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="d405_mount_joint" type="fixed">
    <parent link="$(arg d405_mount_parent)"/><child link="d405_link"/>
    <origin xyz="$(arg d405_mount_xyz)" rpy="$(arg d405_mount_rpy)"/>
  </joint>
  <!-- Simulation uses nominal optical axes; hardware gets calibrated internal TF from the SDK. -->
  <xacro:if value="$(arg camera_nominal_tf)">
    <link name="d405_color_frame"/>
    <joint name="d405_color_joint" type="fixed"><parent link="d405_link"/><child link="d405_color_frame"/></joint>
    <link name="d405_color_optical_frame"/>
    <joint name="d405_color_optical_joint" type="fixed">
      <parent link="d405_color_frame"/><child link="d405_color_optical_frame"/>
      <origin rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <link name="d405_depth_frame"/>
    <joint name="d405_depth_joint" type="fixed"><parent link="d405_link"/><child link="d405_depth_frame"/></joint>
    <link name="d405_depth_optical_frame"/>
    <joint name="d405_depth_optical_joint" type="fixed">
      <parent link="d405_depth_frame"/><child link="d405_depth_optical_frame"/>
      <origin rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
  </xacro:if>
</robot>
