<root BTCPP_format="4" main_tree_to_execute="ParameterizedDemo">
  <BehaviorTree ID="ParameterizedDemo">
    <Sequence>
      <ClearOctomap once="true" timeout="30.0" fresh_clouds="2"/>
      <MoveHome/>
      <MakeTcpPose x="0" y="0" z="0.30" relative="true" pose="{lift_pose}"/>
      <MoveTcp pose="{lift_pose}"/>
      <SetGripper opening="0" unit="mm" duration="3"/>
      <MoveHome/>
      <SetGripper opening="100" unit="mm" duration="3"/>
    </Sequence>
  </BehaviorTree>
</root>
