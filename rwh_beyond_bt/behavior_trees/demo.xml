<root BTCPP_format="4" main_tree_to_execute="Demo">
  <!-- Shared sim/real scenario; backend and clock are selected by launch mode. -->
  <BehaviorTree ID="Demo">
    <Sequence name="PickSequence">
      <Sequence name="PrepareAndObserve">
        <CheckGraspReady server_timeout="1000"/>
        <ClearOctomap once="false" timeout="30.0" fresh_clouds="2"/>
        <!-- Optional home_joint_positions="0;0;0;0;0;0" overrides YAML for this node. -->
        <MoveHome server_timeout="1000"/>
        <!-- Optional opening (m) and duration (s) override gripper opening defaults. -->
        <OpenGripper server_timeout="1000"/>
        <!-- x/y/z offsets in base axes (m), tilt_deg (home-local Y degrees); optional settle_time (s) and home_joint_positions. -->
        <MoveObservation x="0.0" y="0.0" z="0.10" tilt_deg="40.0" server_timeout="1000"/>
        <ClearOctomap once="false" timeout="30.0" fresh_clouds="2"/>
      </Sequence>
      <Sequence name="PerceiveAndPlan">
        <SegmentObject server_timeout="1000" observation_id="{observation}" mask="{object_mask}"/>
        <BuildObjectCloud server_timeout="1000" observation_id="{observation}" mask="{object_mask}" cloud="{object_cloud}"/>
        <InferGrasps server_timeout="1000" observation_id="{observation}" cloud="{object_cloud}" candidates="{grasps}"/>
        <SelectFeasibleGrasp server_timeout="1000" observation_id="{observation}" cloud="{object_cloud}" candidates="{grasps}" plan_id="{grasp_plan}" pregrasp="{pregrasp}"/>
      </Sequence>
      <Sequence name="GraspAndLift">
        <MoveToPregrasp server_timeout="1000" plan_id="{grasp_plan}"/>
        <ApproachGrasp server_timeout="1000" plan_id="{grasp_plan}"/>
        <!-- Close the gripper, then attach the target for planning without judging physical grip. -->
        <AttachObject server_timeout="1000" plan_id="{grasp_plan}"/>
        <LiftObject server_timeout="1000" plan_id="{grasp_plan}"/>
      </Sequence>
      <Sequence name="ReturnHome">
        <MoveObservation x="0.0" y="0.0" z="0.10" tilt_deg="40.0" server_timeout="1000"/>
        <MoveHome server_timeout="1000"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>
</root>
