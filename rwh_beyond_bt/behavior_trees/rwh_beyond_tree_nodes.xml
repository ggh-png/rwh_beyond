<root BTCPP_format="4">
    <TreeNodesModel>
        <Action ID="CloseGripper">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="MoveHome">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="MoveTcp">
            <input_port name="x" type="double">Required target x in metres</input_port>
            <input_port name="qz" type="double">Optional target quaternion z; supply all four components</input_port>
            <input_port name="qw" type="double">Optional target quaternion w; supply all four components</input_port>
            <input_port name="y" type="double">Required target y in metres</input_port>
            <input_port name="qx" type="double">Optional target quaternion x; supply all four components</input_port>
            <input_port name="z" type="double">Required target z in metres</input_port>
            <input_port name="frame_id" type="std::string" default="base_link">Target reference frame</input_port>
            <input_port name="qy" type="double">Optional target quaternion y; supply all four components</input_port>
            <input_port name="tcp_link" type="std::string" default="tcp_link">Controlled TCP link</input_port>
            <input_port name="relative" type="bool" default="false">Interpret xyz as offsets along reference-frame axes</input_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="MoveTcpUp">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="OpenGripper">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="SetGripper">
            <input_port name="opening" type="int">Required total opening width in mm (0..100); percent optional via unit</input_port>
            <input_port name="unit" type="std::string" default="mm">Opening unit: mm (default) or percent</input_port>
            <input_port name="duration" type="double" default="3.000000">Trajectory duration in seconds (0, 3600]</input_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
    </TreeNodesModel>
</root>

