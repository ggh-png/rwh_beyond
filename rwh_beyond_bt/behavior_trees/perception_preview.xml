<root BTCPP_format="4" main_tree_to_execute="PerceptionPreview">
  <!-- Simulation-only observation motion, followed by segmentation/cloud build; no pick. -->
  <BehaviorTree ID="PerceptionPreview">
    <Sequence>
      <CheckGraspReady server_timeout="1000"/>
      <ClearOctomap once="true" timeout="30.0" fresh_clouds="2"/>
      <MoveHome/>
      <OpenGripper/>
      <MoveObservation/>
      <SegmentObject server_timeout="1000" observation_id="{observation}" mask="{object_mask}"/>
      <BuildObjectCloud server_timeout="1000" observation_id="{observation}" mask="{object_mask}" cloud="{object_cloud}"/>
    </Sequence>
  </BehaviorTree>
</root>
