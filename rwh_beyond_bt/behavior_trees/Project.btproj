<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" project_name="Project">
    <include path="demo_width.xml"/>
    <include path="nav2_tree_nodes.xml"/>
    <include path="rwh_beyond_tree_nodes.xml"/>
    <!-- Description of Node Models (used by Groot) -->
    <TreeNodesModel>
        <Action ID="ApproachGrasp">
            <input_port name="plan" type="std::shared_ptr&lt;rwh_beyond_bt::GraspPlan&gt;"/>
        </Action>
        <Condition ID="AreErrorCodesPresent">
            <input_port name="error_codes_to_check" type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;">Error codes to check</input_port>
            <input_port name="error_code" type="unsigned short">The active error codes</input_port>
        </Condition>
        <Condition ID="ArePosesNear">
            <input_port name="global_frame" type="std::string">Global frame</input_port>
            <input_port name="tolerance" default="0.500000" type="double">Tolerance</input_port>
            <input_port name="target_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Destination</input_port>
            <input_port name="ref_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Destination</input_port>
        </Condition>
        <Action ID="AssistedTeleop">
            <input_port name="time_allowance" default="10.000000" type="double">Allowed time for running assisted teleop</input_port>
            <input_port name="is_recovery" default="false" type="bool">If true the recovery count will be incremented</input_port>
            <output_port name="error_code_id" type="unsigned short">The assisted teleop behavior server error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="AttachObject">
            <input_port name="plan" type="std::shared_ptr&lt;rwh_beyond_bt::GraspPlan&gt;"/>
        </Action>
        <Action ID="BackUp">
            <input_port name="backup_dist" default="0.150000" type="double">Distance to backup</input_port>
            <input_port name="backup_speed" default="0.025000" type="double">Speed at which to backup</input_port>
            <input_port name="time_allowance" default="10.000000" type="double">Allowed time for reversing</input_port>
            <output_port name="error_code_id" type="unsigned short">The back up behavior server error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="BuildObjectCloud">
            <output_port name="cloud" type="sensor_msgs::msg::PointCloud2_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="mask" type="sensor_msgs::msg::Image_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="capture" type="std::shared_ptr&lt;rwh_beyond_bt::RgbdObservation const&gt;"/>
        </Action>
        <Action ID="CancelAssistedTeleop">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="CancelBackUp">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="CancelComputeAndTrackRoute">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="CancelControl">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="CancelDriveOnHeading">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="CancelSpin">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="CancelWait">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="CaptureRgbd">
            <output_port name="observation_id" type="std::string"/>
            <output_port name="capture" type="std::shared_ptr&lt;rwh_beyond_bt::RgbdObservation const&gt;"/>
            <input_port name="timeout" default="10.000000" type="double">Fresh exposure wait in seconds</input_port>
        </Action>
        <Action ID="CheckGraspReady">
            <input_port name="release_previous" default="false" type="bool">Explicitly release prior payload in place</input_port>
        </Action>
        <Action ID="ClearCostmapAroundPose">
            <input_port name="reset_distance" default="1.000000" type="double">Distance from the pose under which obstacles are cleared</input_port>
            <input_port name="pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Pose around which to clear the costmap</input_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="service_name" type="std::string">please_set_service_name_in_BT_Node</input_port>
        </Action>
        <Action ID="ClearCostmapAroundRobot">
            <input_port name="reset_distance" default="1.000000" type="double">Distance from the robot under which obstacles are cleared</input_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="service_name" type="std::string">please_set_service_name_in_BT_Node</input_port>
        </Action>
        <Action ID="ClearCostmapExceptRegion">
            <input_port name="reset_distance" default="1.000000" type="double">Distance from the robot above which obstacles are cleared</input_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="service_name" type="std::string">please_set_service_name_in_BT_Node</input_port>
        </Action>
        <Action ID="ClearEntireCostmap">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="service_name" type="std::string">please_set_service_name_in_BT_Node</input_port>
        </Action>
        <Action ID="ClearOctomap">
            <input_port name="scene_service" default="/get_planning_scene" type="std::string">MoveIt planning scene service</input_port>
            <input_port name="cloud_topic" default="/camera/depth/filtered_points" type="std::string">Robot-filtered depth XYZ</input_port>
            <input_port name="service_name" default="/clear_octomap" type="std::string">MoveIt clear service</input_port>
            <input_port name="fresh_clouds" default="2" type="int">Distinct nonempty depth clouds required after clear</input_port>
            <input_port name="timeout" default="30.000000" type="double">Total wall-time limit in seconds</input_port>
            <input_port name="once" default="true" type="bool">Skip after successful initialization for this node instance</input_port>
        </Action>
        <Action ID="ComputeAndTrackRoute">
            <output_port name="route" type="nav2_msgs::msg::Route_&lt;std::allocator&lt;void&gt; &gt;">List of RouteNodes to go from start to end</output_port>
            <output_port name="current_edge_id" type="unsigned short">ID of current edge</output_port>
            <input_port name="server_name" type="std::string">Action server name</input_port>
            <input_port name="start_id" type="unsigned int">ID of the start node</input_port>
            <input_port name="goal_id" type="unsigned int">ID of the goal node</input_port>
            <output_port name="error_code_id" type="unsigned short">The compute route error code</output_port>
            <output_port name="rerouted" type="bool">Whether the plan has rerouted</output_port>
            <input_port name="start" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Start pose of the path if overriding current robot pose and using poses over IDs</input_port>
            <input_port name="use_poses" default="false" type="bool">Whether to use poses or IDs for start and goal</input_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <output_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path created by ComputeAndTrackRoute node</output_port>
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Goal pose of the path if using poses over IDs</input_port>
            <input_port name="use_start" default="false" type="bool">Whether to use the start pose or the robot's current pose</input_port>
            <output_port name="execution_duration" type="builtin_interfaces::msg::Duration_&lt;std::allocator&lt;void&gt; &gt;">Time taken to compute and track route</output_port>
            <output_port name="next_node_id" type="unsigned short">ID of the next node</output_port>
            <output_port name="last_node_id" type="unsigned short">ID of the previous node</output_port>
        </Action>
        <Action ID="ComputePathThroughPoses">
            <input_port name="goals" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">Destinations to plan through</input_port>
            <input_port name="start" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Start pose of the path if overriding current robot pose</input_port>
            <output_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path created by ComputePathThroughPoses node</output_port>
            <input_port name="planner_id" type="std::string">Mapped name to the planner plugin type to use</input_port>
            <output_port name="error_code_id" type="unsigned short">The compute path through poses error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="ComputePathToPose">
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Destination to plan to</input_port>
            <input_port name="start" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Used as the planner start pose instead of the current robot pose, if use_start is not false (i.e. not provided or set to true)</input_port>
            <output_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path created by ComputePathToPose node</output_port>
            <input_port name="planner_id" type="std::string">Mapped name to the planner plugin type to use</input_port>
            <output_port name="error_code_id" type="unsigned short">The compute path to pose error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="use_start" type="bool">For using or not using (i.e. ignoring) the provided start pose</input_port>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="ComputeRoute">
            <input_port name="start" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Start pose of the path if overriding current robot pose and using poses over IDs</input_port>
            <input_port name="use_poses" default="false" type="bool">Whether to use poses or IDs for start and goal</input_port>
            <output_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path created by ComputeRoute node</output_port>
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Goal pose of the path if using poses over IDs</input_port>
            <output_port name="route" type="nav2_msgs::msg::Route_&lt;std::allocator&lt;void&gt; &gt;">The route computed by ComputeRoute node</output_port>
            <output_port name="planning_time" type="builtin_interfaces::msg::Duration_&lt;std::allocator&lt;void&gt; &gt;">Time taken to compute route</output_port>
            <input_port name="goal_id" type="unsigned int">ID of the goal node</input_port>
            <output_port name="error_code_id" type="unsigned short">The compute route error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="start_id" type="unsigned int">ID of the start node</input_port>
            <input_port name="use_start" default="false" type="bool">Whether to use the start pose or the robot's current pose</input_port>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="ConcatenatePaths">
            <output_port name="output_path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Paths concatenated</output_port>
            <input_port name="input_path2" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Input Path 2 to cancatenate</input_port>
            <input_port name="input_path1" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Input Path 1 to cancatenate</input_port>
        </Action>
        <Action ID="ControllerSelector">
            <output_port name="selected_controller" type="std::string">Selected controller by subscription</output_port>
            <input_port name="topic_name" default="controller_selector" type="std::string">the input topic name to select the controller</input_port>
            <input_port name="default_controller" type="std::string">the default controller to use if there is not any external topic message received.</input_port>
        </Action>
        <Decorator ID="DistanceController">
            <input_port name="robot_base_frame" type="std::string">Robot base frame</input_port>
            <input_port name="global_frame" type="std::string">Global frame</input_port>
            <input_port name="distance" default="1.000000" type="double">Distance</input_port>
        </Decorator>
        <Condition ID="DistanceTraveled">
            <input_port name="robot_base_frame" type="std::string">Robot base frame</input_port>
            <input_port name="global_frame" type="std::string">Global frame</input_port>
            <input_port name="distance" default="1.000000" type="double">Distance</input_port>
        </Condition>
        <Action ID="DriveOnHeading">
            <input_port name="speed" default="0.025000" type="double">Speed at which to travel</input_port>
            <input_port name="time_allowance" default="10.000000" type="double">Allowed time for driving on heading</input_port>
            <output_port name="error_code_id" type="unsigned short">The drive on heading behavior server error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="dist_to_travel" default="0.150000" type="double">Distance to travel</input_port>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="FollowPath">
            <input_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path to follow</input_port>
            <input_port name="controller_id" type="std::string"/>
            <input_port name="goal_checker_id" type="std::string"/>
            <input_port name="progress_checker_id" type="std::string"/>
            <output_port name="error_code_id" type="unsigned short">The follow path error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="GetCurrentPose">
            <output_port name="current_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Current pose output</output_port>
            <input_port name="robot_base_frame" type="std::string">Robot base frame</input_port>
            <input_port name="global_frame" type="std::string">Global reference frame</input_port>
        </Action>
        <Action ID="GetPoseFromPath">
            <input_port name="index" default="0" type="int">Index of pose to extract from. -1 is end of list</input_port>
            <output_port name="pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Stamped Extracted Pose</output_port>
            <input_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path to extract pose from</input_port>
        </Action>
        <Condition ID="GlobalUpdatedGoal">
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Navigation goal</input_port>
            <input_port name="goals" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">Vector of navigation goals</input_port>
        </Condition>
        <Action ID="GoalCheckerSelector">
            <output_port name="selected_goal_checker" type="std::string">Selected goal_checker by subscription</output_port>
            <input_port name="topic_name" default="goal_checker_selector" type="std::string">the input topic name to select the goal_checker</input_port>
            <input_port name="default_goal_checker" type="std::string">the default goal_checker to use if there is not any external topic message received.</input_port>
        </Action>
        <Condition ID="GoalReached">
            <input_port name="robot_base_frame" type="std::string">Robot base frame</input_port>
            <input_port name="global_frame" type="std::string">Global frame</input_port>
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Destination</input_port>
        </Condition>
        <Condition ID="GoalUpdated">
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Navigation goal</input_port>
            <input_port name="goals" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">Vector of navigation goals</input_port>
        </Condition>
        <Decorator ID="GoalUpdatedController">
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Navigation goal</input_port>
            <input_port name="goals" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">Vector of navigation goals</input_port>
        </Decorator>
        <Decorator ID="GoalUpdater">
            <output_port name="output_goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Received Goal by subscription</output_port>
            <input_port name="input_goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Original Goal</input_port>
        </Decorator>
        <Action ID="InferGrasps">
            <input_port name="cloud" type="sensor_msgs::msg::PointCloud2_&lt;std::allocator&lt;void&gt; &gt;"/>
            <output_port name="candidates" type="std::vector&lt;rwh_beyond_msgs::msg::GraspCandidate_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;rwh_beyond_msgs::msg::GraspCandidate_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Condition ID="InitialPoseReceived">
            <input_port name="initial_pose_received" type="bool"/>
        </Condition>
        <Condition ID="IsBatteryCharging">
            <input_port name="battery_topic" default="/battery_status" type="std::string">Battery topic</input_port>
        </Condition>
        <Condition ID="IsBatteryLow">
            <input_port name="is_voltage" default="false" type="bool">If true voltage will be used to check for low battery</input_port>
            <input_port name="battery_topic" default="/battery_status" type="std::string">Battery topic</input_port>
            <input_port name="min_battery" type="double">Minimum battery percentage/voltage</input_port>
        </Condition>
        <Condition ID="IsPathValid">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path to Check</input_port>
        </Condition>
        <Condition ID="IsStuck"/>
        <Action ID="LiftObject">
            <input_port name="plan" type="std::shared_ptr&lt;rwh_beyond_bt::GraspPlan&gt;"/>
        </Action>
        <Action ID="MoveHome">
            <input_port name="home_joint_positions" type="std::vector&lt;double, std::allocator&lt;double&gt; &gt;">Six joint angles (rad)</input_port>
        </Action>
        <Action ID="MoveObservation">
            <input_port name="z" type="double">Base Z offset (m)</input_port>
            <input_port name="tilt_deg" type="double">Home-local Y tilt (deg)</input_port>
            <input_port name="settle_time" type="double">Observation settling time (s)</input_port>
            <input_port name="x" type="double">Base X offset (m)</input_port>
            <input_port name="y" type="double">Base Y offset (m)</input_port>
            <input_port name="home_joint_positions" type="std::vector&lt;double, std::allocator&lt;double&gt; &gt;">Six joint angles (rad)</input_port>
        </Action>
        <Action ID="MovePlace">
            <input_port name="z" type="double">Base Z offset (m)</input_port>
            <input_port name="x" type="double">Base X offset (m)</input_port>
            <input_port name="home_joint_positions" type="std::vector&lt;double, std::allocator&lt;double&gt; &gt;">Six joint angles (rad)</input_port>
        </Action>
        <Action ID="MoveToPregrasp">
            <input_port name="plan" type="std::shared_ptr&lt;rwh_beyond_bt::GraspPlan&gt;"/>
        </Action>
        <Action ID="NavigateThroughPoses">
            <input_port name="goals" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">Destinations to plan through</input_port>
            <input_port name="behavior_tree" type="std::string">Behavior tree to run</input_port>
            <output_port name="error_code_id" type="unsigned short">The navigate through poses error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="NavigateToPose">
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Destination to plan to</input_port>
            <input_port name="behavior_tree" type="std::string">Behavior tree to run</input_port>
            <output_port name="error_code_id" type="unsigned short">Navigate to pose error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="OpenGripper">
            <input_port name="opening" type="double">Gripper total gap (m)</input_port>
            <input_port name="duration" type="double">Gripper duration (s)</input_port>
        </Action>
        <Condition ID="PathExpiringTimer">
            <input_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="seconds" default="1.000000" type="double">Seconds</input_port>
        </Condition>
        <Decorator ID="PathLongerOnApproach">
            <input_port name="prox_len" default="3.000000" type="double">Proximity length (m) for the path to be longer on approach</input_port>
            <input_port name="length_factor" default="2.000000" type="double">Length multiplication factor to check if the path is significantly longer</input_port>
            <input_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Planned Path</input_port>
        </Decorator>
        <Control ID="PipelineSequence"/>
        <Action ID="PlannerSelector">
            <output_port name="selected_planner" type="std::string">Selected planner by subscription</output_port>
            <input_port name="topic_name" default="planner_selector" type="std::string">the input topic name to select the planner</input_port>
            <input_port name="default_planner" type="std::string">the default planner to use if there is not any external topic message received.</input_port>
        </Action>
        <Action ID="ProgressCheckerSelector">
            <output_port name="selected_progress_checker" type="std::string">Selected progress_checker by subscription</output_port>
            <input_port name="topic_name" default="progress_checker_selector" type="std::string">the input topic name to select the progress_checker</input_port>
            <input_port name="default_progress_checker" type="std::string">the default progress_checker to use if there is not any external topic message received.</input_port>
        </Action>
        <Decorator ID="RateController">
            <input_port name="hz" default="10.000000" type="double">Rate</input_port>
        </Decorator>
        <Control ID="RecoveryNode">
            <input_port name="number_of_retries" default="1" type="int">Number of retries</input_port>
        </Control>
        <Action ID="ReinitializeGlobalLocalization">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="service_name" type="std::string">please_set_service_name_in_BT_Node</input_port>
        </Action>
        <Action ID="ReleaseObject">
            <input_port name="opening" type="double">Gripper total gap (m)</input_port>
            <input_port name="duration" type="double">Gripper duration (s)</input_port>
        </Action>
        <Action ID="RemovePassedGoals">
            <input_port name="robot_base_frame" type="std::string">Robot base frame</input_port>
            <input_port name="global_frame" type="std::string">Global frame</input_port>
            <input_port name="radius" default="0.500000" type="double">radius to goal for it to be considered for removal</input_port>
            <output_port name="output_goals" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">Goals with passed viapoints removed</output_port>
            <input_port name="input_goals" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">Original goals to remove viapoints from</input_port>
        </Action>
        <Control ID="RoundRobin"/>
        <Action ID="SegmentObject">
            <input_port name="capture" type="std::shared_ptr&lt;rwh_beyond_bt::RgbdObservation const&gt;"/>
            <input_port name="target_text" type="std::string">Optional target description</input_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <output_port name="mask" type="sensor_msgs::msg::Image_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="SelectFeasibleGrasp">
            <output_port name="close_width" type="double"/>
            <output_port name="grasp_width" type="double"/>
            <output_port name="pregrasp" type="rwh_beyond_msgs::msg::TcpPose_&lt;std::allocator&lt;void&gt; &gt;"/>
            <output_port name="selected_plan" type="std::shared_ptr&lt;rwh_beyond_bt::GraspPlan&gt;"/>
            <input_port name="pregrasp_distance" type="double">Approach offset (m); omit for bt_motion YAML</input_port>
            <output_port name="grasp_pose" type="rwh_beyond_msgs::msg::TcpPose_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="capture" type="std::shared_ptr&lt;rwh_beyond_bt::RgbdObservation const&gt;"/>
            <input_port name="cloud" type="sensor_msgs::msg::PointCloud2_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="candidates" type="std::vector&lt;rwh_beyond_msgs::msg::GraspCandidate_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;rwh_beyond_msgs::msg::GraspCandidate_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
            <input_port name="use_estimated_width" default="false" type="bool">Estimate close width from point cloud</input_port>
            <input_port name="mask" type="sensor_msgs::msg::Image_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="lift_distance" type="double">Lift distance (m); omit for bt_motion YAML</input_port>
        </Action>
        <Decorator ID="SingleTrigger"/>
        <Action ID="SmoothPath">
            <input_port name="unsmoothed_path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path to be smoothed</input_port>
            <input_port name="smoother_id" type="std::string"/>
            <output_port name="smoothed_path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path smoothed by SmootherServer node</output_port>
            <output_port name="smoothing_duration" type="double">Time taken to smooth path</output_port>
            <output_port name="was_completed" type="bool">True if smoothing was not interrupted by time limit</output_port>
            <input_port name="max_smoothing_duration" default="3.000000" type="double">Maximum smoothing duration</input_port>
            <input_port name="check_for_collisions" default="false" type="bool">If true collision check will be performed after smoothing</input_port>
            <output_port name="error_code_id" type="unsigned short">The smooth path error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="SmootherSelector">
            <output_port name="selected_smoother" type="std::string">Selected smoother by subscription</output_port>
            <input_port name="topic_name" default="smoother_selector" type="std::string">the input topic name to select the smoother</input_port>
            <input_port name="default_smoother" type="std::string">the default smoother to use if there is not any external topic message received.</input_port>
        </Action>
        <Decorator ID="SpeedController">
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Navigation goal</input_port>
            <input_port name="goals" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">Vector of navigation goals</input_port>
            <input_port name="max_speed" default="0.500000" type="double">Maximum speed</input_port>
            <input_port name="max_rate" default="1.000000" type="double">Maximum rate</input_port>
            <input_port name="min_speed" default="0.000000" type="double">Minimum speed</input_port>
            <input_port name="min_rate" default="0.100000" type="double">Minimum rate</input_port>
        </Decorator>
        <Action ID="Spin">
            <input_port name="spin_dist" default="1.570000" type="double">Spin distance</input_port>
            <input_port name="time_allowance" default="10.000000" type="double">Allowed time for spinning</input_port>
            <input_port name="is_recovery" default="true" type="bool">True if recovery</input_port>
            <output_port name="error_code_id" type="unsigned short">The spin behavior error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Condition ID="TimeExpired">
            <input_port name="seconds" default="1.000000" type="double">Seconds</input_port>
        </Condition>
        <Condition ID="TransformAvailable">
            <input_port name="parent" type="std::string">parent frame for transform</input_port>
            <input_port name="child" type="std::string">Child frame for transform</input_port>
        </Condition>
        <Action ID="TruncatePath">
            <input_port name="distance" default="1.000000" type="double">distance</input_port>
            <output_port name="output_path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path truncated to a certain distance</output_port>
            <input_port name="input_path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Original Path</input_port>
        </Action>
        <Action ID="TruncatePathLocal">
            <input_port name="transform_tolerance" default="0.200000" type="double">Transform lookup tolerance</input_port>
            <input_port name="max_robot_pose_search_dist" default="inf" type="double">Maximum forward integrated distance along the path (starting from the last detected pose) to bound the search for the closest pose to the robot. When set to infinity (default), whole path is searched every time</input_port>
            <input_port name="robot_frame" default="base_link" type="std::string">Robot base frame id</input_port>
            <input_port name="pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Manually specified pose to be usedif overriding current robot pose</input_port>
            <input_port name="distance_backward" default="4.000000" type="double">Distance in backward direction</input_port>
            <input_port name="distance_forward" default="8.000000" type="double">Distance in forward direction</input_port>
            <input_port name="angular_distance_weight" default="0.000000" type="double">Weight of angular distance relative to positional distance when finding which path pose is closest to robot. Not applicable on paths without orientations assigned</input_port>
            <output_port name="output_path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path truncated to a certain distance around robot</output_port>
            <input_port name="input_path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Original Path</input_port>
        </Action>
        <Action ID="Wait">
            <input_port name="wait_duration" default="1.000000" type="double">Wait time</input_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Condition ID="WouldAControllerRecoveryHelp">
            <input_port name="error_codes_to_check" type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;">Error codes to check</input_port>
            <input_port name="error_code" type="unsigned short">The active error codes</input_port>
        </Condition>
        <Condition ID="WouldAPlannerRecoveryHelp">
            <input_port name="error_codes_to_check" type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;">Error codes to check</input_port>
            <input_port name="error_code" type="unsigned short">The active error codes</input_port>
        </Condition>
        <Condition ID="WouldASmootherRecoveryHelp">
            <input_port name="error_codes_to_check" type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;">Error codes to check</input_port>
            <input_port name="error_code" type="unsigned short">The active error codes</input_port>
        </Condition>
    </TreeNodesModel>
</root>
